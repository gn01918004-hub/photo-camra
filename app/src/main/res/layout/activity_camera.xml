<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <TextureView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <View
        android:id="@+id/flash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:alpha="0" />

    <!-- 上方：返回、目前點號、修改點號 -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <Button
            android:id="@+id/backBtn"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_cam_chip"
            android:minWidth="0"
            android:paddingHorizontal="14dp"
            android:stateListAnimator="@null"
            android:text="‹ 返回"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/editPointBtn"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_cam_chip"
            android:minWidth="0"
            android:paddingHorizontal="14dp"
            android:stateListAnimator="@null"
            android:text="修改點號"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/pointBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_cam_badge"
            android:paddingHorizontal="14dp"
            android:paddingVertical="4dp"
            android:text="點號:1"
            android:textColor="#FFD25A"
            android:textSize="28sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 下方：最近一張、快門、今日張數 -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingVertical="20dp">

        <ImageView
            android:id="@+id/lastThumb"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_cam_chip"
            android:contentDescription="最近一張"
            android:scaleType="centerCrop" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <Button
                android:id="@+id/shutterBtn"
                android:layout_width="78dp"
                android:layout_height="78dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_shutter"
                android:contentDescription="拍照"
                android:stateListAnimator="@null" />
        </FrameLayout>

        <TextView
            android:id="@+id/countText"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
