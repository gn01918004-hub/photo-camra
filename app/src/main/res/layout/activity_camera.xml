<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <TextureView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <View
        android:id="@+id/flash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="#FFFFFF" />

    <!-- 上方：返回、修改點號、目前點號 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <ImageButton
            android:id="@+id/backBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_cam_chip"
            android:contentDescription="返回"
            android:src="@drawable/ic_back"
            android:stateListAnimator="@animator/press_scale"
            android:tint="#FFFFFF" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/editPointBtn"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_cam_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:stateListAnimator="@animator/press_scale">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_edit"
                android:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="修改點號"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/pointBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_cam_badge"
            android:fontFamily="@font/barlow_bold"
            android:paddingHorizontal="16dp"
            android:paddingVertical="2dp"
            android:text="點號:1"
            android:textColor="#FFB547"
            android:textSize="34sp" />
    </LinearLayout>

    <!-- 下方：模式切換、最近一張、快門、今日張數 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="22dp">

        <RadioGroup
            android:id="@+id/camModeGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_cam_seg"
            android:orientation="horizontal"
            android:padding="4dp">

            <RadioButton
                android:id="@+id/camModePoint"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/bg_cam_seg_item"
                android:button="@null"
                android:gravity="center"
                android:paddingHorizontal="18dp"
                android:text="點號照片"
                android:textColor="@color/cam_seg_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/camModeResult"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/bg_cam_seg_item"
                android:button="@null"
                android:gravity="center"
                android:paddingHorizontal="18dp"
                android:text="成果圖"
                android:textColor="@color/cam_seg_text"
                android:textSize="14sp"
                android:textStyle="bold" />
        </RadioGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="28dp">

            <ImageView
                android:id="@+id/lastThumb"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:background="@drawable/bg_thumb"
                android:clipToOutline="true"
                android:contentDescription="最近一張"
                android:scaleType="centerCrop" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <Button
                    android:id="@+id/shutterBtn"
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_shutter"
                    android:contentDescription="拍照"
                    android:stateListAnimator="@animator/press_scale" />
            </FrameLayout>

            <TextView
                android:id="@+id/countText"
                android:layout_width="58dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
