<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false"><layer-list>
        <item><shape android:shape="oval"><stroke android:width="4dp" android:color="#80FFFFFF" /></shape></item>
        <item android:bottom="9dp" android:left="9dp" android:right="9dp" android:top="9dp">
            <shape android:shape="oval"><solid android:color="#66FFFFFF" /></shape></item>
    </layer-list></item>
    <item android:state_selected="true"><layer-list>
        <item><shape android:shape="oval"><stroke android:width="4dp" android:color="#FFFFFF" /></shape></item>
        <item android:bottom="9dp" android:left="9dp" android:right="9dp" android:top="9dp">
            <shape android:shape="oval"><gradient android:angle="315" android:startColor="#FFFFFF" android:endColor="#DDE6E1" /></shape></item>
    </layer-list></item>
    <item><layer-list>
        <item><shape android:shape="oval"><stroke android:width="4dp" android:color="#FFFFFF" /></shape></item>
        <item android:bottom="9dp" android:left="9dp" android:right="9dp" android:top="9dp">
            <shape android:shape="oval"><gradient android:angle="315" android:startColor="@color/amber" android:endColor="@color/amber2" /></shape></item>
    </layer-list></item>
</selector>
